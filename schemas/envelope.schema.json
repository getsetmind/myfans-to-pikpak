{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myfans-to-pikpak:schema:envelope:1",
  "title": "MyFans to PikPak CLI JSON envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "result", "warnings", "error"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "result": {},
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "details": {}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "properties": { "error": { "type": "null" } } },
      "else": {
        "properties": {
          "result": { "type": "null" },
          "error": { "type": "object" }
        }
      }
    }
  ]
}
