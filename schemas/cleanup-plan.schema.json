{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myfans-to-pikpak:schema:cleanup-plan:1",
  "title": "MyFans to PikPak cleanup plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "planId",
    "target",
    "sourcePlanDigest",
    "createdAt",
    "items",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "cleanup" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
    "target": { "type": "string", "minLength": 1 },
    "sourcePlanDigest": { "$ref": "#/$defs/digest" },
    "createdAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "#/$defs/digest" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["postId", "path", "size"],
        "properties": {
          "postId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
